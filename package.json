{
  "name": "dsh-weekly-report",
  "version": "0.1.6",
  "description": "按时间段挑选 DSH 会话与项目 git 提交，参考你自己以前写的报告样例，生成日报/周报/月报（Markdown）。Pick DSH sessions and git commits for a window, then write a daily/weekly/monthly report in your own house style.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/core.test.mjs test/prompt.test.mjs test/plugin.test.mjs test/client-hooks.test.mjs",
    "e2e": "node test/e2e-agent-flow.mjs",
    "list": "node scripts/collect.mjs sessions"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "report",
    "weekly-report",
    "daily-report",
    "markdown",
    "git"
  ],
  "license": "MIT",
  "author": "l956615272-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l956615272-hub/dsh-weekly-report.git"
  },
  "homepage": "https://github.com/l956615272-hub/dsh-weekly-report#readme",
  "bugs": {
    "url": "https://github.com/l956615272-hub/dsh-weekly-report/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
